datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(uuid())
  username  String     @unique
  email     String?    @unique
  password  String
  role      String     @default("USER") // ADMIN or USER
  progress  Progress[]
  bugReports BugReport[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Library {
  id                String             @id @default(uuid())
  name              String             @unique
  description       String?
  isActive          Boolean            @default(true)
  folderPattern     String?
  books             Book[]
  sources           LibrarySource[]
  scanJobs          LibraryScanJob[]
  silenceCheckJobs  SilenceCheckJob[]
  indexedFiles      IndexedAudioFile[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model LibrarySource {
  id         String   @id @default(uuid())
  library    Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  libraryId  String
  label      String?
  path       String   @unique
  kind       String   @default("LOCAL") // LOCAL, MAPPED, NETWORK
  isEnabled  Boolean  @default(true)
  isWritable Boolean  @default(false)
  isWatched  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([libraryId, isEnabled])
  @@index([libraryId, isWritable])
  @@index([libraryId, isWatched])
}

model Author {
  id    String @id @default(uuid())
  name  String @unique
  books Book[]
}

model Series {
  id    String @id @default(uuid())
  name  String @unique
  books Book[]
}

model Book {
  id               String      @id @default(uuid())
  title            String
  subtitle         String?
  library          Library     @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  libraryId        String
  author           Author      @relation(fields: [authorId], references: [id])
  authorId         String
  series           Series?     @relation(fields: [seriesId], references: [id])
  seriesId         String?
  sequence         Float?
  narrator         String?
  description      String?
  publisher        String?
  year             String?
  genres           String?
  tags             String?
  language         String?
  isbn             String?
  asin             String?
  abridged         Boolean     @default(false)
  coverPath        String?
  duration         Float       @default(0)
  folderPath       String      @unique
  metadataVersion  Int         @default(0)
  audioFiles       AudioFile[]
  indexedFiles     IndexedAudioFile[]
  chapters         Chapter[]
  progress         Progress[]
  ignoredDuplicateAsA IgnoredDuplicatePair[] @relation("IgnoredDuplicateBookA")
  ignoredDuplicateAsB IgnoredDuplicatePair[] @relation("IgnoredDuplicateBookB")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([libraryId, title, authorId])
  @@index([libraryId])
  @@index([authorId])
  @@index([seriesId])
  @@index([createdAt])
  @@index([year])
  @@index([narrator])
  @@index([publisher])
  @@index([language])
  @@index([asin])
  @@index([isbn])
  @@index([abridged])
}

model IgnoredDuplicatePair {
  id        String   @id @default(uuid())
  bookA     Book     @relation("IgnoredDuplicateBookA", fields: [bookAId], references: [id], onDelete: Cascade)
  bookAId   String
  bookB     Book     @relation("IgnoredDuplicateBookB", fields: [bookBId], references: [id], onDelete: Cascade)
  bookBId   String
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookAId, bookBId])
  @@index([bookAId])
  @@index([bookBId])
}

model LibraryScanJob {
  id             String             @id @default(uuid())
  library        Library?           @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  libraryId      String?
  status         String             @default("queued")
  trigger        String?
  totalFolders   Int?
  scannedFolders Int                @default(0)
  totalFiles     Int?
  scannedFiles   Int                @default(0)
  retryCount     Int                @default(0)
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  indexedFiles   IndexedAudioFile[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([libraryId, status])
  @@index([status, createdAt])
  @@index([createdAt])
}

model IndexedAudioFile {
  id            String          @id @default(uuid())
  library       Library         @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  libraryId     String
  book          Book?           @relation(fields: [bookId], references: [id], onDelete: SetNull)
  bookId        String?
  lastScanJob   LibraryScanJob? @relation(fields: [lastScanJobId], references: [id], onDelete: SetNull)
  lastScanJobId String?
  path          String          @unique
  fileName      String
  extension     String
  sizeBytes     BigInt
  modifiedAt    DateTime
  checksum      String?
  durationSec   Int?
  codec         String?
  bitrate       Int?
  scanStatus        String          @default("pending")
  error             String?
  lastScannedAt     DateTime?
  isSilent          Boolean?
  maxVolumeDb       Float?
  silenceCheckedAt  DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([libraryId, scanStatus])
  @@index([isSilent])
  @@index([bookId])
  @@index([lastScanJobId])
  @@index([modifiedAt])
  @@index([checksum])
}

model SilenceCheckJob {
  id           String    @id @default(uuid())
  library      Library?  @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  libraryId    String?
  status       String    @default("queued")
  trigger      String?
  totalFiles   Int?
  checkedFiles Int       @default(0)
  silentFiles  Int       @default(0)
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([libraryId, status])
  @@index([status, createdAt])
}

model Chapter {
  id        String @id @default(uuid())
  title     String
  start     Float
  end       Float
  book      Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId    String

  @@index([bookId, start])
}

model AudioFile {
  id               String   @id @default(uuid())
  filename         String
  title            String?
  path             String
  duration         Float
  index            Int
  book             Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId           String
  isSilent         Boolean?
  maxVolumeDb      Float?
  silenceCheckedAt DateTime?

  @@index([bookId, index])
  @@index([isSilent])
}

model Progress {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId       String
  currentTime  Float    @default(0)
  isFinished   Boolean  @default(false)
  lastUpdate   DateTime @updatedAt

  @@unique([userId, bookId])
  @@index([userId, isFinished])
  @@index([bookId])
  @@index([lastUpdate])
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BugReport {
  id        String   @id @default(uuid())
  type      String
  status    String   @default("open")
  comment   String?
  path      String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
  @@index([userId])
}
